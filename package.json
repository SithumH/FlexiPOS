{
  "name": "flexipos",
  "version": "1.0.0",
  "description": "FlexiPOS - Customizable Offline-First POS Platform for Sri Lankan Small Businesses",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/server.ts",
    "dev:client": "vite",
    "dev:electron": "concurrently -k \"npm run dev:client\" \"wait-on tcp:5173 && electron src/desktop/main.cjs\"",
    "build:server": "tsc",
    "build:client": "vite build",
    "build:desktop": "npm run build:client && electron-builder --win",
    "pack:desktop": "npm run build:client && electron-builder --dir",
    "start": "node dist/server/server.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "pos",
    "sri-lanka",
    "grocery",
    "offline-first",
    "multi-tenant",
    "modular-monolith"
  ],
  "author": "FlexiPOS Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.5.1"
  }
}
